import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist


class MiPrimerNodo(Node):
    def __init__(self):
        super().__init__('mi_primer_nodo')
        self.pub = self.create_publisher(Twist, 'cmd_vel', 1)
        self.timer = self.create_timer(1.0, self.publicar)
        self.contador = 0

    def publicar(self):
        vel = Twist()
        vel.linear.x = 0.2
        vel.angular.z = 0.0

        self.pub.publish(vel)
        self.get_logger().info(
            f'[{self.contador}] linear.x={vel.linear.x} | angular.z={vel.angular.z}'
        )
        self.contador += 1


def main():
    rclpy.init()
    nodo = MiPrimerNodo()
    try:
        rclpy.spin(nodo)
    except KeyboardInterrupt:
        pass
    nodo.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
